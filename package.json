{
  "name": "@ankhorage/zora-game",
  "version": "0.8.18",
  "type": "module",
  "description": "Generic game presentation primitives for React Native and React Native Web apps built on ZORA.",
  "homepage": "https://github.com/ankhorage/zora-game#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/zora-game/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/zora-game.git"
  },
  "keywords": [
    "ankhorage",
    "expo",
    "game",
    "game-ui",
    "react-native",
    "react-native-web",
    "ui-kit",
    "zora"
  ],
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "react-native": "./src/metadata.ts",
      "browser": "./src/metadata.ts",
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@ankhorage/zora": ">=20.3.4",
    "react": "19.2.3",
    "react-native": "0.86.x"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src && bun run expo:acceptance",
    "docs": "paradox",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "prepack": "bun run build",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "version-packages": "ankhorage-changeset version",
    "expo:acceptance": "bun scripts/validate-expo-candidate.ts"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.18.5",
    "@ankhorage/paradox": "^0.1.26",
    "@ankhorage/zora": "^20.3.4",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@ankhorage/game": "^0.1.2",
    "@ankhorage/runtime": "^3.0.10"
  }
}
